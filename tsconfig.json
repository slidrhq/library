{
  // The app's compiler options (tsconfig.base.json of github.com/slidrhq/app): the app's modules
  // this page imports are checked with the options they are written for.
  "extends": "../app/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "paths": { "@desktop/*": ["../app/apps/desktop/src/*"] }
  },
  "include": ["src", "vite.config.ts"]
}
