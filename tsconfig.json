{
  // The app's compiler options: the app's modules this page imports (vendor/) are checked with
  // the options they are written for.
  "extends": "./vendor/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "paths": { "@desktop/*": ["./vendor/desktop/src/*"] }
  },
  "include": ["src", "vite.config.ts", "vite.node.config.ts"]
}
