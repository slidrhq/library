{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "library",
  "main": "./server/host/cloudflare/index.ts",
  "compatibility_date": "2026-10-01",
  // The page, built by Vite (`@cloudflare/vite-plugin` points the Worker at `dist/client`).
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Signing in (server/core/auth.ts), the uploads (server/core/uploads) and the published
    // library (server/core/media); everything else is served as it was built.
    "run_worker_first": ["/auth/*", "/api/*", "/media/*"],
  },
  // What is uploaded, until it is published (README, "Uploading"), with a publication's own
  // records beside it; and the published library itself, which the uploads are published into
  // (README, "Publishing the uploads"), and which media.slidr.studio serves as it is (README,
  // "Serving the library"). `pnpm dev` keeps buckets of its own on this machine, in `.wrangler/`.
  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "slidr-library-uploads" },
    { "binding": "MEDIA", "bucket_name": "slidr-media" },
  ],
  // The library's own jobs (server/core/media/sweep.ts), once a minute: an approved upload that
  // could not be written at once is written then, and rejected uploads are cleared after 30 days.
  "triggers": { "crons": ["* * * * *"] },
  // A publication writes the files made of the catalog of the designs, some 55 MB (designFiles.ts),
  // and folds managed.json into it (designCatalog.ts): more than the default 30 s of CPU, which
  // stopped the Worker midway (error 1102) on 2026-10-28. Five minutes is the most Cloudflare gives.
  "limits": { "cpu_ms": 300000 },
  // GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are secrets of the Worker (`wrangler secret put`),
  // and `.dev.vars` on this machine (README, "Signing in"). LIBRARY_MASTER_KEY is a secret of the
  // repository too, which each deploy gives the Worker (deploy.yml). MEDIA_ZONE_ID and
  // MEDIA_PURGE_TOKEN, which empty the cache before the library, are secrets of the Worker only
  // (README, "Serving the library").
}
