{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "library",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  // The page, built by Vite (`@cloudflare/vite-plugin` points the Worker at `dist/client`).
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Signing in (worker/auth.ts) and the uploads (worker/uploads); everything else is served as
    // it was built.
    "run_worker_first": ["/auth/*", "/api/*"],
  },
  // What is uploaded, until it is published (README, "Uploading"). `pnpm dev` keeps a bucket of
  // its own on this machine, in `.wrangler/`.
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "slidr-library-uploads" }],
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, SESSION_SECRET, LIBRARY_EDITORS and LIBRARY_KEYS are
  // secrets of the Worker (`wrangler secret put`), and `.dev.vars` on this machine (README,
  // "Signing in", "Uploading").
}
