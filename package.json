{
  "name": "@slidr/library",
  "version": "0.2.2",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.node.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server && tsc --noEmit -p docker/test && tsc --noEmit -p install/test",
    "test": "node --import ./server/node.mjs --test \"server/**/*.test.ts\"",
    "library": "node --import ./server/node.mjs server/host/node/cli.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "vendor": "node scripts/vendor.mjs",
    "nginx-types": "node --import ./server/node.mjs scripts/nginx-types.mjs"
  },
  "dependencies": {
    "@slidr/media-library": "workspace:*",
    "@slidr/model": "workspace:*",
    "@slidr/renderer": "workspace:*",
    "@slidr/templates": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "wrangler": "^4.151.2"
  }
}
